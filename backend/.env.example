PORT=5001
HOST=0.0.0.0
ALLOWED_ORIGIN=http://192.168.100.4:8081
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-host>/?appName=Cluster0
MONGODB_DB=gradproject2
# Secret used to sign JWT auth tokens. Use a long random string in production.
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=30d

# Speech-to-text (Whisper) service. The backend spawns it automatically.
# Set STT_AUTOSTART=false to run ./stt-service manually instead.
STT_AUTOSTART=true
STT_PORT=8000
