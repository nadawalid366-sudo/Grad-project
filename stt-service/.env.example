# Application settings
APP_NAME="Speech to Text API"
APP_VERSION="1.0.0"
DEBUG=True
PORT=8000
HOST=0.0.0.0

# Whisper Model — options: tiny | base | small | medium | large
# Smaller = faster but less accurate. "tiny" is recommended for CPU-only machines.
WHISPER_MODEL="tiny"

# Supported audio formats (comma-separated)
ALLOWED_EXTENSIONS="mp3,wav,m4a,webm"

# Maximum upload file size in MB
MAX_FILE_SIZE_MB=50

# CORS Origins — use * to allow all origins, or specify comma-separated URLs
CORS_ORIGINS="*"

# API Key Protection — leave blank to disable (open access)
# Set a strong secret key to require "X-API-Key" header on all requests
API_KEY=""
